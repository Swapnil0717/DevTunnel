{
  "name": "@devtunnelcli/cli",
  "version": "0.1.0",
  "description": "DevTunnel CLI — automates the GitHub contribution workflow: dev login, dev start, dev test, dev submit.",
  "type": "module",
  "bin": {
    "dev": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/<org>/DevTunnel.git",
    "directory": "devtunnel-cli"
  },
  "homepage": "https://devtunnel.tech",
  "bugs": "https://github.com/<org>/DevTunnel/issues",
  "license": "MIT",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup src/index.ts --format esm --target node18 --clean --shims",
    "typecheck": "tsc --noEmit",
    "link": "npm run build && npm link",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "open": "^10.1.0",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2",
    "simple-git": "^3.27.0"
  },
  "devDependencies": {
    "@types/node": "20.14.9",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}