{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/task-understanding-record/2.0.0.json",
  "title": "Task Understanding Record",
  "description": "Phase 2 canonical schema for an engineering Task derived from a GitHub Issue plus available engineering context. Extends Phase 1 (Issue -> Understanding) with a richer task representation while preserving field-level provenance.",
  "type": "object",
  "required": ["schema_version", "task_identity", "task", "provenance", "uncertainty", "confidence", "review"],
  "additionalProperties": false,
  "properties": {

    "schema_version": {
      "type": "string",
      "description": "Semantic version of this record's schema shape.",
      "pattern": "^2\\.\\d+\\.\\d+$"
    },

    "task_identity": {
      "type": "object",
      "required": ["task_id", "created_at", "source_issue"],
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "type": "string",
          "description": "UUIDv4 generated at task-record creation time. Not derived from the GitHub issue ID.",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO-8601 timestamp of record generation."
        },
        "source_issue": {
          "type": "object",
          "required": ["repo", "issue_number", "issue_url", "snapshot_fetched_at"],
          "additionalProperties": false,
          "properties": {
            "repo": { "type": "string", "description": "owner/repo" },
            "issue_number": { "type": "integer", "minimum": 1 },
            "issue_url": { "type": "string", "format": "uri" },
            "snapshot_fetched_at": {
              "type": "string",
              "format": "date-time",
              "description": "When the issue body/comments were fetched. Issues can be edited later; this pins the input snapshot per Phase 1 traceability requirements."
            },
            "issue_title_raw": { "type": "string", "description": "Verbatim original issue title, kept for audit even though Task.title may differ." }
          }
        }
      }
    },

    "task": {
      "type": "object",
      "description": "The structured engineering task. Represents the work to be done, not merely the original issue text.",
      "required": [
        "title", "summary", "objective", "description", "expected_outcome",
        "role", "experience_level", "complexity", "task_type",
        "scope", "acceptance_criteria"
      ],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
        "objective": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "expected_outcome": { "type": "string", "minLength": 1 },

        "role": { "$ref": "#/$defs/roleValue" },
        "experience_level": { "$ref": "#/$defs/experienceValue" },
        "complexity": { "$ref": "#/$defs/complexityValue" },
        "task_type": { "$ref": "#/$defs/taskTypeValue" },

        "technologies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "languages": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "frameworks": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "technical_areas": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "components": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "systems": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "affected_areas": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },

        "dependencies": {
          "type": "array",
          "items": { "$ref": "#/$defs/dependency" }
        },

        "scope": {
          "type": "object",
          "required": ["in_scope", "out_of_scope"],
          "additionalProperties": false,
          "properties": {
            "in_scope": { "type": "array", "items": { "type": "string" } },
            "out_of_scope": { "type": "array", "items": { "type": "string" } }
          }
        },

        "acceptance_criteria": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Testable statements defining done. May be empty only if role/experience/complexity/task_type are all Unknown (see validation rules)."
        },

        "constraints": { "type": "array", "items": { "type": "string" } }
      }
    },

    "provenance": {
      "type": "object",
      "description": "One entry per classifiable/extractable field in `task`, keyed by dotted field path (e.g. 'role', 'scope.in_scope', 'dependencies').",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/provenanceEntry" }
    },

    "uncertainty": {
      "type": "object",
      "required": ["explicit_information", "inferred_information", "uncertain_information", "missing_information"],
      "additionalProperties": false,
      "description": "Derived rollups of the provenance map, provided for consumers that don't want to parse the full per-field provenance object. Must stay consistent with `provenance` (see validation rules).",
      "properties": {
        "explicit_information": { "type": "array", "items": { "$ref": "#/$defs/informationItem" } },
        "inferred_information": { "type": "array", "items": { "$ref": "#/$defs/informationItem" } },
        "uncertain_information": {
          "type": "array",
          "description": "Fields that are not Unknown but fall below the confidence threshold, or are flagged as genuinely ambiguous despite having a value.",
          "items": { "$ref": "#/$defs/informationItem" }
        },
        "missing_information": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Freeform statements of what additional information would improve the classification."
        }
      }
    },

    "confidence": {
      "type": "object",
      "required": ["overall_confidence", "method"],
      "additionalProperties": false,
      "properties": {
        "overall_confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "method": {
          "type": "string",
          "const": "weighted_mean_v1",
          "description": "Identifies the aggregation formula used, so downstream consumers can recompute or compare across schema minor versions."
        }
      }
    },

    "review": {
      "type": "object",
      "required": ["review_required", "review_reasons"],
      "additionalProperties": false,
      "properties": {
        "review_required": { "type": "boolean" },
        "review_reasons": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Must be non-empty if review_required is true; must be empty if false."
        }
      }
    }
  },

  "$defs": {
    "roleValue": { "enum": ["Frontend", "Backend", "Fullstack", "Unknown"] },
    "experienceValue": { "enum": ["Beginner", "Intermediate", "Advanced", "Unknown"] },
    "complexityValue": { "enum": ["Low", "Medium", "High", "Unknown"] },
    "taskTypeValue": {
      "enum": ["Bug", "Feature", "Improvement", "Refactor", "Performance", "Security", "Maintenance", "Documentation", "Other", "Unknown"],
      "description": "Extensible: new values are added via a MINOR schema-version bump to the allowed-values registry, not a structural change."
    },

    "sourceType": {
      "enum": ["EXPLICIT", "SUPPORTED_BY_CONTEXT", "INFERRED", "UNKNOWN"],
      "description": "Renames of Phase 1's stated/contextual/inferred/unknown; see versioning strategy for the mapping."
    },

    "provenanceEntry": {
      "type": "object",
      "required": ["source", "evidence", "confidence"],
      "additionalProperties": false,
      "properties": {
        "source": { "$ref": "#/$defs/sourceType" },
        "evidence": {
          "type": ["string", "null"],
          "description": "Non-null and non-empty unless source is UNKNOWN, in which case it must be null."
        },
        "confidence": {
          "type": ["number", "null"],
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Non-null unless source is UNKNOWN, in which case it must be null."
        }
      }
    },

    "informationItem": {
      "type": "object",
      "required": ["field", "evidence"],
      "additionalProperties": false,
      "properties": {
        "field": { "type": "string", "description": "Dotted path into `task`, matching a key in `provenance`." },
        "evidence": { "type": "string" },
        "note": { "type": "string", "description": "Optional free-text note, used e.g. to explain why an item is uncertain." }
      }
    },

    "dependency": {
      "type": "object",
      "required": ["type", "ref", "description"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["blocks", "blocked_by", "relates_to", "requires"] },
        "ref": {
          "type": "string",
          "description": "Either an entry present in task.components/task.systems, or an external issue reference matching ^(#\\d+|[A-Za-z0-9_.-]+#\\d+)$."
        },
        "description": { "type": "string" }
      }
    }
  }
}
