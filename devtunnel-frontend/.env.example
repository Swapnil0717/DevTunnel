# Base URL of the DevTunnel backend API (see devtunnel_workflow.txt, Module C1 — Authentication).
# The frontend never talks to GitHub directly — it only calls these backend routes:
#   POST /auth/github   -> starts the GitHub OAuth redirect
#   GET  /auth/callback -> backend-only, receives the GitHub `code` (never called by the browser)
#   GET  /auth/me       -> returns the current session's user, or 401
#   POST /auth/logout   -> clears the session
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public, canonical URL of this frontend. Used to build canonical links,
# Open Graph metadata, and the sitemap (Frontend_Development_Rules.txt, rules 8 & 29).
NEXT_PUBLIC_SITE_URL=https://devtunnel.dev
