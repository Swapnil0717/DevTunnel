# Base URL of the DevTunnel backend API (see devtunnel_workflow: Module C1).
# Called with credentials: "include" so the backend can set/read the
# httpOnly session cookie. Must be reachable from the browser.
NEXT_PUBLIC_API_URL=https://api.devtunnel.tech

# Canonical public origin of this frontend, used to build canonical URLs,
# Open Graph tags, and sitemap.xml / robots.txt entries.
NEXT_PUBLIC_SITE_URL=https://devtunnel.tech

# Never add OAuth client secrets, signing keys, or database credentials
# here. Any NEXT_PUBLIC_* variable ships to the browser and is not secret
# (Frontend_Development_Rules.txt, rule 19). GitHub OAuth client secret
# exchange happens only on the backend.
